<Window x:Class="BitviseLogViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BitviseLogViewer"
        mc:Ignorable="d"
        Title="Bitvise Log Viewer" Height="800" Width="1200" Icon="app.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
        <TabItem Header="Log queries">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: folder, event types, filters, LogParser, output -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <GroupBox Header="Log folder" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6">
                                Point out a local folder containing Bitvise log files (*.log). If you
                                don't have the logs locally: log in to the server running Bitvise SSH
                                Server and copy the files from "C:\Program Files\Bitvise SSH Server\Logs"
                                to a local folder.
                            </TextBlock>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="6,0,0,0" Click="BrowseLogFolder_Click"/>
                                <TextBox x:Name="LogFolderTextBox"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Event types" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <CheckBox x:Name="LogonsCheckBox" Content="Logons" Margin="0,2"/>

                            <CheckBox x:Name="TransfersCheckBox" Content="Uploads/downloads" Margin="0,2" Checked="TransfersCheckBox_CheckedChanged" Unchecked="TransfersCheckBox_CheckedChanged"/>
                            <StackPanel Margin="20,0,0,0">
                                <CheckBox x:Name="UploadOnlyCheckBox" Content="Uploads only" Margin="0,2" IsEnabled="False"/>
                                <CheckBox x:Name="DownloadOnlyCheckBox" Content="Downloads only" Margin="0,2" IsEnabled="False"/>
                            </StackPanel>

                            <CheckBox x:Name="RemovesCheckBox" Content="Deleted files" Margin="0,2"/>
                            <CheckBox x:Name="SecurityCheckBox" Content="Security/algorithms (SSH key exchange + TLS)" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Filters (optional)" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <TextBlock Text="Virtual account (LIKE, e.g. erp-* or part of the name):"/>
                            <TextBox x:Name="VirtualAccountTextBox" Margin="0,2,0,8"/>

                            <TextBlock Text="File name/path (e.g. *.docx):"/>
                            <TextBox x:Name="FilePatternTextBox" Margin="0,2,0,8"/>

                            <TextBlock Text="Remote IP:"/>
                            <TextBox x:Name="RemoteIpTextBox" Margin="0,2,0,8"/>

                            <TextBlock Text="Date &amp; time from:"/>
                            <DockPanel Margin="0,2,0,8">
                                <TextBox x:Name="TimeFromTextBox" DockPanel.Dock="Right" Width="70" Margin="6,0,0,0" ToolTip="Time HH:mm (optional)"/>
                                <DatePicker x:Name="DateFromPicker"/>
                            </DockPanel>

                            <TextBlock Text="Date &amp; time to:"/>
                            <DockPanel Margin="0,2,0,8">
                                <TextBox x:Name="TimeToTextBox" DockPanel.Dock="Right" Width="70" Margin="6,0,0,0" ToolTip="Time HH:mm (optional)"/>
                                <DatePicker x:Name="DateToPicker"/>
                            </DockPanel>

                            <TextBlock Text="Server version (remoteAddr vs. remoteAddress):" Margin="0,4,0,0"/>
                            <ComboBox x:Name="RemoteAddressFormatComboBox" Margin="0,2,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="Auto-detect from the log file (recommended)"/>
                                <ComboBoxItem Content="New (remoteAddr, Bitvise ≥ 9.51)"/>
                                <ComboBoxItem Content="Legacy (remoteAddress, Bitvise &lt; 9.51)"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="LogParser" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6">
                                Requires Microsoft LogParser (winget install Microsoft.LogParser).
                                Leave the field empty if LogParser.exe is on the PATH.
                            </TextBlock>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="6,0,0,0" Click="BrowseLogParserExe_Click"/>
                                <TextBox x:Name="LogParserPathTextBox"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Output" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <RadioButton x:Name="OutputScreenRadio" Content="Screen (show in the table below)" IsChecked="True" GroupName="Output" Margin="0,2" Checked="OutputMode_Changed"/>
                            <RadioButton x:Name="OutputFileRadio" Content="File (let LogParser write CSV)" GroupName="Output" Margin="0,2" Checked="OutputMode_Changed"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="6,0,0,0" Click="BrowseOutputFile_Click" x:Name="BrowseOutputButton" IsEnabled="False"/>
                                <TextBox x:Name="OutputFileTextBox" IsEnabled="False"/>
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0" FontStyle="Italic">
                                When several event types are selected, one file per category is created (a suffix is added to the file name).
                            </TextBlock>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="BuildQueryButton" Content="Build query" Padding="10,4" Margin="0,0,8,0" Click="BuildQueryButton_Click"/>
                        <Button x:Name="RunButton" Content="Run" Padding="10,4" Margin="0,0,8,0" Click="RunButton_Click"/>
                        <Button x:Name="CopyQueryButton" Content="Copy query" Padding="10,4" Click="CopyQueryButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Right panel: generated query (editable) + results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Generated LogParser query (editable – fine-tune before running if needed)">
                    <TextBox x:Name="QueryTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Margin="4"/>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Results">
                    <DataGrid x:Name="ResultsDataGrid" AutoGenerateColumns="True" IsReadOnly="True"
                              Margin="4" CanUserAddRows="False"/>
                </GroupBox>
            </Grid>
        </Grid>
        </TabItem>

        <TabItem Header="Account statistics (Stats)">
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: Stats folder, filters, LogParser, output -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <GroupBox Header="Stats folder" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6">
                                Point out a local folder containing Bitvise statistics files (*.xml),
                                one file per account/group. They live in "C:\Program Files\Bitvise SSH
                                Server\Stats" on the server — copy them locally the same way as the
                                log files.
                            </TextBlock>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="6,0,0,0" Click="BrowseStatsFolder_Click"/>
                                <TextBox x:Name="StatsFolderTextBox"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Filters (optional)" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <TextBlock Text="Account (LIKE, e.g. erp-* or part of the name):"/>
                            <TextBox x:Name="StatsAccountTextBox" Margin="0,2,0,8"/>

                            <CheckBox x:Name="StatsIncludeGroupsCheckBox" Content="Include groups and server total (not just individual accounts)" Margin="0,2"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="LogParser" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6">
                                Requires Microsoft LogParser. Leave empty if LogParser.exe is on the PATH.
                            </TextBlock>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="6,0,0,0" Click="BrowseStatsLogParserExe_Click"/>
                                <TextBox x:Name="StatsLogParserPathTextBox"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Output" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <RadioButton x:Name="StatsOutputScreenRadio" Content="Screen (show in the table below)" IsChecked="True" GroupName="StatsOutput" Margin="0,2" Checked="StatsOutputMode_Changed"/>
                            <RadioButton x:Name="StatsOutputFileRadio" Content="File (let LogParser write CSV)" GroupName="StatsOutput" Margin="0,2" Checked="StatsOutputMode_Changed"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="6,0,0,0" Click="BrowseStatsOutputFile_Click" x:Name="StatsBrowseOutputButton" IsEnabled="False"/>
                                <TextBox x:Name="StatsOutputFileTextBox" IsEnabled="False"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="StatsBuildQueryButton" Content="Build query" Padding="10,4" Margin="0,0,8,0" Click="StatsBuildQueryButton_Click"/>
                        <Button x:Name="StatsRunButton" Content="Run" Padding="10,4" Margin="0,0,8,0" Click="StatsRunButton_Click"/>
                        <Button x:Name="StatsCopyQueryButton" Content="Copy query" Padding="10,4" Click="StatsCopyQueryButton_Click"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Right panel: generated query (editable) + results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Generated LogParser query (editable)">
                    <TextBox x:Name="StatsQueryTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Margin="4"/>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Results (account overview, most recent logon first)">
                    <DataGrid x:Name="StatsResultsDataGrid" AutoGenerateColumns="True" IsReadOnly="True"
                              Margin="4" CanUserAddRows="False"/>
                </GroupBox>
            </Grid>
        </Grid>
        </TabItem>
        </TabControl>

        <StatusBar Grid.Row="1" Margin="0,8,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
